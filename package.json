{
  "name": "render-farm",
  "productName": "Render Farm",
  "version": "0.2.0",
  "description": "Local batch rendering for Maya and Blender on Windows and macOS",
  "main": "./out/main/index.js",
  "author": "Kim Yongwon",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test test/platform.test.ts test/runner.test.ts && node --import tsx test/engine.test.ts",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "format": "prettier --write src test *.json *.ts *.yml",
    "format:check": "prettier --check src test *.json *.ts *.yml"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15",
    "prettier": "3.8.2"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryonghwon/render-farm.git"
  },
  "homepage": "https://github.com/ryonghwon/render-farm",
  "bugs": {
    "url": "https://github.com/ryonghwon/render-farm/issues"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
